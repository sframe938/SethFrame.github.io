{
  "version": 8,
  "name": "ADK Peak Map (no Standard)",
  "sprite": "mapbox://sprites/sframe938/cmt75d6wj00gv01s47s2q8ml4/ekhs3dcuv5r9q7oec7g99s8qj",
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "sources": {
    "mapbox://mapbox.mapbox-terrain-dem-v1": {
      "url": "mapbox://mapbox.mapbox-terrain-dem-v1",
      "type": "raster-dem",
      "tileSize": 256
    },
    "composite": {
      "url": "mapbox://mapbox.mapbox-streets-v8,mapbox.mapbox-terrain-v2,mapbox.mapbox-bathymetry-v2",
      "type": "vector"
    },
    "mapbox://mapbox.mapbox-terrain-v2-contour": {
      "url": "mapbox://mapbox.mapbox-terrain-v2-contour",
      "type": "vector"
    }
  },
  "layers": [
    {
      "id": "land",
      "type": "background",
      "paint": { "background-color": "#e1e2e7" }
    },
    {
      "id": "landuse-greenspace",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["wood", "scrub", "grass", "park", "agriculture", "cemetery"], true, false],
      "paint": { "fill-color": "#a2ab57", "fill-opacity": 1 }
    },
    {
      "id": "landcover-greenspace",
      "type": "fill",
      "source": "composite",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["wood", "scrub", "grass", "crop"], true, false],
      "paint": { "fill-color": "#a2ab57", "fill-opacity": 1 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "composite",
      "source-layer": "water",
      "paint": { "fill-color": "#a5c2ea" }
    },
    {
      "id": "mapbox-dem",
      "type": "hillshade",
      "source": "mapbox://mapbox.mapbox-terrain-dem-v1",
      "layout": { "visibility": "visible" },
      "paint": {
        "hillshade-exaggeration": ["interpolate", ["exponential", 1.99], ["zoom"], 0, 0.3, 10, 0.8],
        "hillshade-shadow-color": "#414922",
        "hillshade-accent-color": "hsl(50, 69%, 51%)",
        "hillshade-highlight-color": "#ffffff",
        "hillshade-illumination-direction": 0
      }
    },
    {
      "id": "contour",
      "type": "line",
      "source": "mapbox://mapbox.mapbox-terrain-v2-contour",
      "source-layer": "contour",
      "minzoom": 10,
      "filter": ["match", ["get", "index"], [-1], false, true],
      "layout": { "line-cross-slope": 0, "line-elevation-reference": "ground" },
      "paint": {
        "line-color": ["interpolate", ["linear"], ["measure-light", "brightness"], 0.25, "hsla(40, 36%, 75%, 0.5)", 0.3, "hsla(40, 36%, 25%, 0.5)"],
        "line-opacity": ["interpolate", ["exponential", 1.75], ["zoom"], 9.5, 0, 12.5, 1],
        "line-width": ["case", ["==", ["%", ["get", "ele"], 100], 0], 0.6, 0.2]
      }
    },
    {
      "id": "contour-label",
      "type": "symbol",
      "source": "mapbox://mapbox.mapbox-terrain-v2-contour",
      "source-layer": "contour",
      "minzoom": 11,
      "filter": ["all", ["any", ["==", ["get", "index"], 10], ["==", ["get", "index"], 5]]],
      "layout": {
        "text-font": ["Roboto Medium", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 8, 18, 13],
        "symbol-placement": "line",
        "symbol-spacing": 300,
        "text-field": ["to-string", ["get", "ele"]]
      },
      "paint": {
        "text-color": ["interpolate", ["linear"], ["measure-light", "brightness"], 0.25, "hsl(40, 6%, 75%)", 0.3, "hsl(40, 36%, 25%)"],
        "text-opacity": ["interpolate", ["linear"], ["zoom"], 11.5, 0, 12, 1],
        "text-halo-width": 1,
        "text-halo-color": ["interpolate", ["linear"], ["measure-light", "brightness"], 0.25, "hsla(0, 0%, 0%, 0.6)", 0.3, "hsla(20, 20%, 100%, 0.6)"]
      }
    },
    {
      "id": "natural-label-peak",
      "type": "symbol",
      "source": "composite",
      "source-layer": "natural_label",
      "filter": ["all", ["match", ["get", "class"], ["landform"], true, false], ["==", ["geometry-type"], "Point"]],
      "layout": {
        "visibility": "none",
        "text-field": ["case", ["has", "name"], ["get", "name"], ""],
        "text-font": ["Roboto Bold Italic", "Arial Unicode MS Regular"],
        "text-size": 14
      },
      "paint": { "text-color": "hsl(58, 68%, 18%)", "text-halo-color": "hsl(20, 20%, 100%)", "text-halo-width": 1 }
    },
    {
      "id": "natural-label-glacier",
      "type": "symbol",
      "source": "composite",
      "source-layer": "natural_label",
      "filter": ["all", ["match", ["get", "class"], ["glacier"], true, false], ["==", ["geometry-type"], "Point"]],
      "layout": {
        "visibility": "none",
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Roboto Bold Italic", "Arial Unicode MS Regular"],
        "text-size": 14
      },
      "paint": { "text-color": "hsl(199, 70%, 35%)", "text-halo-color": "hsl(20, 20%, 100%)", "text-halo-width": 1 }
    },
    {
      "id": "track-case",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": ["all", ["match", ["get", "class"], ["track"], true, false], ["==", ["geometry-type"], "LineString"]],
      "layout": { "visibility": "none", "line-join": "round" },
      "paint": {
        "line-color": "hsla(0, 0%, 16%, 0.5)",
        "line-dasharray": [4, 1],
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 14, 1, 22, 2]
      }
    },
    {
      "id": "path",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": ["all", ["==", ["get", "class"], "path"], ["==", ["geometry-type"], "LineString"]],
      "layout": { "visibility": "none", "line-join": "round" },
      "paint": {
        "line-dasharray": [2, 2],
        "line-color": "hsl(0, 0%, 16%)"
      }
    },
    {
      "id": "path-track-labels",
      "type": "symbol",
      "source": "composite",
      "source-layer": "road",
      "filter": ["all", ["match", ["get", "class"], ["path", "track"], true, false], ["==", ["geometry-type"], "LineString"]],
      "layout": {
        "visibility": "none",
        "symbol-placement": "line",
        "text-field": ["to-string", ["get", "name"]],
        "text-font": ["Roboto Medium", "Arial Unicode MS Regular"],
        "text-size": 12
      },
      "paint": { "text-color": "hsl(0, 0, 18%)", "text-halo-color": "hsl(20, 20%, 100%)", "text-halo-width": 1 }
    }
  ]
}
